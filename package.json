{
  "name": "dsh-ponytail-v6",
  "version": "1.0.0",
  "description": "Ponytail 6 for DeepSeek Harness: the upstream v5.3.3 ruleset and six skills verbatim, plus native live intensity switching (off/lite/full/ultra) as a cache-stable prompt section. Zero tools.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.2-alpha.2"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "scripts",
    "docs",
    "upstream.lock.json",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "verify": "node scripts/verify.mjs && node scripts/probe-host.mjs",
    "lock": "node scripts/record-lock.mjs",
    "sync-upstream": "bash scripts/sync-upstream.sh",
    "probe": "node scripts/probe-host.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "ponytail",
    "yagni",
    "minimal-code",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhangYunfang/dsh-ponytail-v6.git"
  },
  "homepage": "https://github.com/ZhangYunfang/dsh-ponytail-v6#readme",
  "bugs": {
    "url": "https://github.com/ZhangYunfang/dsh-ponytail-v6/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.2-alpha.2": "compatible"
      }
    }
  }
}
